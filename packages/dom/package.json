{
  "name": "@testa-soft/dom",
  "version": "1.4.0",
  "type": "module",
  "description": "Browser render layer for experiments: crobot-native DOM variation apply (change_html/css/hide_element/append_html/prepend_html/move_element_*) + anti-flicker shielding. Pairs with @testa-soft/experiment-core.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "devDependencies": {
    "@testa-platform/shared-types": "workspace:*",
    "@vitest/coverage-v8": "2.1.5",
    "happy-dom": "15.11.4",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
