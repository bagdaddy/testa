{
  "name": "@testa-soft/next",
  "version": "1.5.0",
  "type": "module",
  "description": "Testa split-URL A/B testing for Next.js \u2014 server-side, flicker-free redirects via middleware.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./router-guard": {
      "types": "./dist/router-guard/index.d.ts",
      "import": "./dist/router-guard/index.js",
      "require": "./dist/router-guard/index.cjs"
    },
    "./_internal/experiments": {
      "types": "./dist/experiments/index.d.ts",
      "import": "./dist/experiments/index.js",
      "require": "./dist/experiments/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./pages": {
      "types": "./dist/router-pages/index.d.ts",
      "import": "./dist/router-pages/index.js",
      "require": "./dist/router-pages/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/add-use-client.mjs && node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "peerDependencies": {
    "next": ">=13.4.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@testa-soft/dom": "workspace:*",
    "@testa-soft/experiment-core": "workspace:*",
    "@testa-soft/react": "workspace:*"
  },
  "devDependencies": {
    "@testa-platform/shared-types": "workspace:*",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitest/coverage-v8": "2.1.5",
    "happy-dom": "15.11.4",
    "next": "15.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
