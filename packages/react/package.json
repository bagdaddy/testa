{
  "name": "@testa-soft/react",
  "version": "1.4.0",
  "type": "module",
  "description": "Testa client-side A/B testing for React + Vite SPAs (single-page apps with no server).",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "@testa-soft/dom": "workspace:*",
    "@testa-soft/experiment-core": "workspace:*"
  },
  "devDependencies": {
    "@testa-platform/shared-types": "workspace:*",
    "@types/react": "18.3.12",
    "@vitest/coverage-v8": "2.1.5",
    "happy-dom": "15.11.4",
    "react": "18.3.1",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
